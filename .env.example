# Database
DATABASE_URL=postgres://user:password@localhost:5432/fitnessdata

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=10000
CORS_ORIGIN=*

# API Key Authentication
# MASTER_KEY is auto-generated by `bun start`. Required to mint API keys.
# MASTER_KEY=<auto-generated>
# Set to 'true' to require API keys on all data endpoints
API_KEY_AUTH_ENABLED=false

# Documentation
SWAGGER_ENABLED=true

# AI Normalization (Optional)
AI_NORMALIZE=false
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
