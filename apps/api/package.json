{
  "name": "api",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist --compile",
    "start": "bun run ./dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "bun test",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "hono": "^4.12.16",
    "@repo/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^16.4.5",
    "zod": "^3.24.1",
    "@hono/zod-openapi": "^0.18.4",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
