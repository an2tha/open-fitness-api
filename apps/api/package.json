{
  "name": "api",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist --compile",
    "start": "bun run ./dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "bun test",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@hono/zod-openapi": "^0.18.4",
    "@repo/db": "workspace:*",
    "@repo/env-manager": "workspace:*",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "pg": "^8.11.3"
  }
}