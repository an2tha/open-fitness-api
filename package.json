{
  "name": "open-fitness-data",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build:docker": "bun run build",
    "docker:build": "bun run build",
    "build": "turbo run build",
    "start": "docker compose up -d",
    "start:db": "docker compose up -d db",
    "stop": "docker compose stop",
    "delete": "docker compose down -v",
    "load": "bun run ./apps/loaders/index.ts",
    "load:verbose": "bun run ./apps/loaders/index.ts",
    "normalize": "bun run --filter ofdata-normalizer start",
    "dev": "turbo run dev",
    "turbo:dev": "turbo run dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "lint": "prettier --check \"README.md\" \"turbo.json\" \"package.json\" \"docker-compose*.yml\" \"{apps,packages,examples,scripts}/**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,mjs}\" \"!**/next-env.d.ts\" && eslint .",
    "lint:fix": "prettier --write \"README.md\" \"turbo.json\" \"package.json\" \"docker-compose*.yml\" \"{apps,packages,examples,scripts}/**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,mjs}\" \"!**/next-env.d.ts\" && eslint . --fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@inquirer/prompts": "^8.4.2",
    "api": "workspace:*",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "postgres": "^3.4.9",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "dependencies": {
    "@types/node": "^25.6.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "nanoid": "^5.1.9",
    "pi": "^2.0.5"
  }
}
